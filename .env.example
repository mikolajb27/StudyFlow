# Skopiuj ten plik jako .env.local i wpisz wartości z konsoli Firebase:
# Ustawienia projektu -> Twoje aplikacje -> aplikacja internetowa -> firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Tylko do testów z lokalnymi emulatorami Firebase (firebase emulators:start):
# VITE_USE_FIREBASE_EMULATORS=true
